{
  "name": "arrow-out-games-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "Static MVP for the Arrow Out browser puzzle validation site.",
  "scripts": {
    "verify": "node scripts/verify-site.mjs && node scripts/verify-arrow-maze.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "verify:arrow-maze": "node scripts/verify-arrow-maze.mjs",
